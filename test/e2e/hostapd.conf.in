# run.sh が @...@ を置き換えて使う
interface=@IFACE@
driver=nl80211
ctrl_interface=@WORK@/hostapd
ssid=simwifi-e2e
hw_mode=g
channel=1
auth_algs=1
wpa=2
wpa_key_mgmt=@KEYMGMT@
rsn_pairwise=CCMP
ieee80211w=@PMF@
ieee8021x=1
eap_server=1
eap_user_file=@HERE@/hostapd.eap_user
eap_sim_db=unix:@WORK@/hlr.sock
eap_sim_aka_result_ind=1
logger_stdout=-1
logger_stdout_level=1
