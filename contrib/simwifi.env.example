# /etc/simwifi/<iface>.env（simwifi@<iface>.service が読む）
#
# systemd の展開規則: ${VAR} は 1 語として渡され（空白を含んでよい）、
# $VAR は空白で分割される（引用符は解釈されない）。

# 接続先の SSID
SSID=example-ssid
# EAP メソッド: aka または akap
METHOD=aka
# 接続時・切断時に /bin/sh -c で実行するコマンド（不要なら空）
EXEC_UP=dhclient -1 -nw wlan0
EXEC_DOWN=dhclient -r wlan0
# その他のオプション（空白で区切る。値に空白を含めないこと）。例: --wpa3 --sim-slot 1
SIMWIFI_OPTS=
